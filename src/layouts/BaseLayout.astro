---
import '../styles/global.css';
import { implementedPageKeys, routeMap, type Locale, type PageKey } from '../data/site';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  title: string;
  description: string;
  canonicalPath?: string;
  alternatePaths?: Partial<Record<Locale, string>>;
  socialImagePath?: string;
  ogType?: 'website' | 'article';
}

const { locale, pageKey, title, description, canonicalPath, alternatePaths, socialImagePath, ogType = 'website' } = Astro.props;
if (!Astro.site) throw new Error('Astro site origin is required for canonical and hreflang URLs.');

const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${basePath}${canonicalPath ?? routeMap[pageKey][locale]}`, Astro.site);
const socialImage = new URL(`${basePath}${socialImagePath ?? '/images/home/employer-escrow.jpeg'}`, Astro.site);
const hasImplementedPair = alternatePaths
  ? Boolean(alternatePaths.en && alternatePaths.es)
  : implementedPageKeys.some((key) => key === pageKey);
const alternates = hasImplementedPair
  ? (['en', 'es'] as const).map((language) => ({
      language,
      href: new URL(`${basePath}${alternatePaths?.[language] ?? routeMap[pageKey][language]}`, Astro.site)
    }))
  : [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Downtown Community Escrow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.language} href={alternate.href} />
    ))}
    {hasImplementedPair && <link rel="alternate" hreflang="x-default" href={new URL(`${basePath}${alternatePaths?.en ?? routeMap[pageKey].en}`, Astro.site)} />}
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
