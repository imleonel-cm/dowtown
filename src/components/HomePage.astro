---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeContent, routeMap, type Locale } from '../data/site';
import { navigationFor } from '../data/navigation';
import { serviceHrefsFor, serviceNavigationFor } from '../data/serviceLinks';
import Header from './Header.astro';
import Footer from './Footer.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Hero from './home/Hero.astro';
import Services from './home/Services.astro';
import Office from './home/Office.astro';
import Questions from './home/Questions.astro';
import ContactCta from './home/ContactCta.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = homeContent[locale];
const navigation = navigationFor(locale, 'home');
const serviceNavigation = serviceNavigationFor(locale);
const headerContent = { ...content.header, navigation, services: serviceNavigation };
const servicesHref = '#services';
const serviceHrefs = serviceHrefsFor(locale);
---

<BaseLayout locale={locale} pageKey="home" title={content.meta.title} description={content.meta.description}>
  <a class="skip-link" href="#main-content">{content.skipLink}</a>
  <Header locale={locale} content={headerContent} wordmarkLabel={content.wordmarkLabel} activePageKey="home" ctaHref={routeMap.contact[locale]} />
  <main id="main-content">
    <Hero content={content.hero} servicesHref={servicesHref} contactHref={routeMap.contact[locale]} />
    <Services content={content.services} serviceHrefs={serviceHrefs} />
    <Office content={content.why} />
    <Questions content={content.questions} />
    <ContactCta content={content.contact} locale={locale} />
  </main>
  <Footer locale={locale} content={content.footer} navigation={navigation} services={serviceNavigation} wordmarkLabel={content.wordmarkLabel} />
  <LanguageSwitcher locale={locale} pageKey="home" label={content.languageSwitcherLabel} />
</BaseLayout>
