---
import type { ServiceIconName } from '../data/business';

interface Props { name: ServiceIconName }
const { name } = Astro.props;
const gradientId = `icon-gradient-${name}`;
---

<svg class="service-icon" viewBox="0 0 72 72" aria-hidden="true">
  <defs>
    <linearGradient id={gradientId} x1="12" y1="8" x2="60" y2="66" gradientUnits="userSpaceOnUse">
      <stop stop-color="#ffffff" />
      <stop offset="1" stop-color="#c9eaff" />
    </linearGradient>
  </defs>
  <rect class="service-icon__shadow" x="9" y="11" width="54" height="54" rx="17" />
  <rect class="service-icon__plate" x="8" y="7" width="54" height="54" rx="17" fill={`url(#${gradientId})`} />
  <g class="service-icon__art">
    {name === 'home' && <><path d="m20 34 16-13 16 13"/><path d="M24 32v16h24V32M32 48V38h8v10"/></>}
    {name === 'document' && <><path d="M25 20h17l7 7v23H25z"/><path d="M42 20v8h7M31 35h12M31 41h12"/></>}
    {name === 'people' && <><circle cx="36" cy="29" r="6"/><circle cx="23" cy="32" r="4"/><circle cx="49" cy="32" r="4"/><path d="M27 50v-3c0-6 4-10 9-10s9 4 9 10v3M18 48v-3c0-4 2-7 6-8M54 48v-3c0-4-2-7-6-8"/></>}
    {name === 'finance' && <><path d="m20 34 16-13 16 13M24 32v16h24V32"/><path d="M39 31h-5a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6h-5M36 28v18"/></>}
    {name === 'residential' && <><path d="m19 35 17-14 17 14"/><path d="M24 33v16h24V33M32 49V39h8v10"/><path d="M45 26v-5h5v9"/></>}
    {name === 'commercial' && <><path d="M22 19h27v31H22zM29 50V24M36 50V24M43 50V24M22 31h27M22 40h27"/><path d="M18 50h35"/></>}
  </g>
</svg>
