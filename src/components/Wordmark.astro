---
import { routeMap, type Locale } from '../data/site';

interface Props {
  inverse?: boolean;
  locale: Locale;
  label: string;
}
const { inverse = false, locale, label } = Astro.props;
---

<a class:list={['wordmark', { 'wordmark--inverse': inverse }]} href={`${routeMap.home[locale]}#home`} aria-label={label}>
  <img class="wordmark__logo" src={inverse ? '/branding/downtown-logo-white.png' : '/branding/downtown-logo.png'} alt="Downtown Community Escrow" width="420" height="120" decoding="async" />
</a>
