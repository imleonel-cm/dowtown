---
type AboutIconName = 'identity' | 'categories' | 'office' | 'contact' | 'neutral' | 'coordination' | 'professionals';

interface Props { name: AboutIconName }
const { name } = Astro.props;
---

<svg class={`about-icon about-icon--${name}`} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <circle class="about-icon__plate" cx="24" cy="24" r="20" />
  <g class="about-icon__art">
    {name === 'identity' && <><path d="M15 17h18l4 4v12H15z" /><path d="M19 22h12M19 27h8M19 32h6" /><path d="M33 17v5h4" /></>}
    {name === 'categories' && <><rect x="15" y="15" width="7" height="7" rx="1.5" /><rect x="26" y="15" width="7" height="7" rx="1.5" /><rect x="15" y="26" width="7" height="7" rx="1.5" /><rect x="26" y="26" width="7" height="7" rx="1.5" /></>}
    {name === 'office' && <><path d="M16 34h17V17H16z" /><path d="M20 22h2M27 22h2M20 27h2M27 27h2M22 34v-4h5v4" /><path d="M34 19c0-3 5-3 5 0 0 2-2.5 4-2.5 4S34 21 34 19Z" /></>}
    {name === 'contact' && <path d="M18 16h5l2 6-3 2c1.4 3 3.4 4.8 6.3 6.2l2-3 5.7 2v5c-8.3 1.2-16.5-6.5-18-18.2Z" />}
    {name === 'neutral' && <><path d="M24 15v20M17 20h14M14 20l-4 8h8zM34 20l-4 8h8zM19 35h10" /></>}
    {name === 'coordination' && <><path d="M14 18h12M22 14l4 4-4 4M34 30H22M26 26l-4 4 4 4" /><circle cx="14" cy="18" r="3" /><circle cx="34" cy="30" r="3" /></>}
    {name === 'professionals' && <><circle cx="24" cy="19" r="4" /><circle cx="16" cy="23" r="3" /><circle cx="32" cy="23" r="3" /><path d="M17 34v-2c0-4 3-7 7-7s7 3 7 7v2M10 33v-2c0-3 2-5 5-5M38 33v-2c0-3-2-5-5-5" /></>}
  </g>
</svg>
