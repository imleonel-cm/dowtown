---
interface FaqContent {
  eyebrow: string;
  heading: string;
  intro: string;
  items: readonly (readonly [string, string])[];
}

interface Props {
  content: FaqContent;
  id?: string;
  groupName?: string;
  className?: string;
}
const { content, id = 'services-faq', groupName = id, className } = Astro.props;
---

<section id={id} class:list={['services-faq', 'section-anchor', className]}>
  <div class="container faq-layout">
    <div class="questions-heading">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2>{content.heading}</h2>
      <p>{content.intro}</p>
    </div>
    <div class="faq-accordion">
      {content.items.map(([question, answer], index) => (
        <details class="faq-item" name={groupName} open={index === 0}>
          <summary>
            <span class="faq-question">{question}</span>
            <span class="faq-symbol" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer"><p>{answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.faq-accordion').forEach((accordion) => {
    const items = Array.from(accordion.querySelectorAll<HTMLDetailsElement>('details'));
    items.forEach((item) => {
      item.querySelector('summary')?.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        item.open = !item.open;
      });
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        items.forEach((other) => {
          if (other !== item) other.open = false;
        });
      });
    });
  });
</script>
