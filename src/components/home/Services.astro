---
import type { HomeContent } from '../../data/site';
import type { ServiceCatalogKey } from '../../data/business';
import Arrow from '../Arrow.astro';
import ServiceCardIcon from '../ServiceCardIcon.astro';

interface Props {
  content: HomeContent['services'];
  serviceHrefs: Partial<Record<ServiceCatalogKey, string>>;
}
const { content, serviceHrefs } = Astro.props;
---

<section id="services" class="services-section section-anchor">
  <div class="container">
    <div class="services-heading">
      <p class="eyebrow">{content.eyebrow}</p>
      <h2>{content.heading}</h2>
      <p>{content.intro}</p>
    </div>
    <div id="services-list" class="service-grid">
      {content.items.map((service, index) => {
        const href = serviceHrefs[service.key];
        const number = String(index + 1).padStart(2, '0');
        return (
          <article id={service.id} class:list={['service-card', 'section-anchor', { 'service-card--featured': index < 3, 'service-card--pending': !href }]}>
            {href ? (
              <a class="service-card__surface" href={href}>
                <ServiceCardIcon name={service.key} />
                <div class="service-card__copy">
                  <div class="service-card__heading">
                    <h3>{service.title}</h3>
                    <span class="service-index" aria-hidden="true">{number}</span>
                  </div>
                  <p>{service.description}</p>
                </div>
                <span class="service-card__arrow" aria-hidden="true"><Arrow /></span>
              </a>
            ) : (
              <div class="service-card__surface">
                <ServiceCardIcon name={service.key} />
                <div class="service-card__copy">
                  <div class="service-card__heading">
                    <h3>{service.title}</h3>
                    <span class="service-index" aria-hidden="true">{number}</span>
                  </div>
                  <p class="service-card__status">{service.description}</p>
                </div>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>
