---
import { business } from '../../data/business';
import type { HomeContent } from '../../data/site';
import type { Locale } from '../../data/site';
import { routeMap } from '../../data/site';
import Arrow from '../Arrow.astro';

interface Props { content: HomeContent['contact']; locale: Locale }
const { content, locale } = Astro.props;
---

<section id="contact" class="contact-cta section-anchor">
  <div class="contact-architecture" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container contact-cta__inner">
    <div>
      <p class="contact-eyebrow">{content.eyebrow}</p>
      <h2>{content.headingLines[0]}<br />{content.headingLines[1]}</h2>
      <p>{content.body}</p>
    </div>
    <div class="contact-cta__actions">
      <a class="contact-button" href={routeMap.contact[locale]}>{content.contactLabel} <Arrow /></a>
      <a class="phone-button" href={business.phoneHref} aria-label={content.callLabel}><span aria-hidden="true">☎</span>{locale === 'en' ? business.phoneDisplay : 'Llamar a la oficina'} <Arrow /></a>
    </div>
  </div>
</section>
