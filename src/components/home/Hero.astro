---
import type { HomeContent } from '../../data/site';
import type { ServiceCatalogKey } from '../../data/business';
import { Picture } from 'astro:assets';
import residentialEscrowImage from '../../assets/residential-escrow-illustration.png';
import Arrow from '../Arrow.astro';
import ServiceIcon from '../ServiceIcon.astro';

interface Props {
  content: HomeContent['hero'];
  servicesHref: string;
  contactHref: string;
  serviceHrefs: Partial<Record<ServiceCatalogKey, string>>;
}

const { content, servicesHref, contactHref, serviceHrefs } = Astro.props;
---

<section id="home" class="hero section-anchor">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker"><span aria-hidden="true"></span> {content.kicker}</p>
      <h1>{content.title} <span>{content.titleAccent}</span></h1>
      <p class="hero-intro">{content.intro}</p>
      <div class="button-row">
        <a class="button" href={servicesHref}>{content.primaryCta} <Arrow /></a>
        <a class="button button--outline" href={contactHref}>{content.secondaryCta}</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-visual__backdrop" aria-hidden="true"></div>
      <figure class="hero-photo">
        <Picture
          src={residentialEscrowImage}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[390, 640, 960, 1280, 1536]}
          sizes="(max-width: 620px) calc(100vw - 36px), (max-width: 980px) calc(100vw - 48px), 47vw"
          width={1536}
          height={1024}
          quality={82}
          alt={content.imageAlt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          pictureAttributes={{ class: 'responsive-picture' }}
        />
        <figcaption>{content.imageCaption}</figcaption>
      </figure>
      <div class="document-stack" aria-hidden="true">
        <span class="document-stack__tab">{content.documentLabel}</span>
        <span class="document-stack__line"></span>
        <span class="document-stack__line document-stack__line--short"></span>
        <span class="document-stack__seal">✓</span>
      </div>
    </div>
    <nav class="hero-specialties" aria-label={content.featuredLabel}>
      {content.featuredServices.map((service) => (
        <a class="hero-specialty-card" href={serviceHrefs[service.key]}>
          <ServiceIcon name={service.key === 'probate' ? 'people' : service.key} />
          <span class="hero-specialty-card__copy">
            <strong>{service.title}</strong>
            <span>{service.description}</span>
          </span>
          <span class="hero-specialty-card__arrow" aria-hidden="true"><Arrow /></span>
        </a>
      ))}
    </nav>
  </div>
</section>
