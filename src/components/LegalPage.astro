---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeContent, routeMap, type Locale } from '../data/site';
import { legalContent, type LegalPageKey } from '../data/legal';
import { navigationFor } from '../data/navigation';
import { serviceNavigationFor } from '../data/serviceLinks';
import Header from './Header.astro';
import Footer from './Footer.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props { locale: Locale; legalPage: LegalPageKey }
const { locale, legalPage } = Astro.props;
const content = legalContent[locale][legalPage];
const shared = homeContent[locale];
const pageKey = legalPage;
const navigation = navigationFor(locale, pageKey);
const services = serviceNavigationFor(locale);
const headerContent = { ...shared.header, navigation, services };
const homeHref = routeMap.home[locale];
const currentHref = routeMap[pageKey][locale];
const breadcrumbItems = [
  { label: content.breadcrumbHome, href: homeHref },
  { label: content.breadcrumbCurrent, href: currentHref }
];
---

<BaseLayout locale={locale} pageKey={pageKey} title={content.meta.title} description={content.meta.description}>
  <a class="skip-link" href="#main-content">{content.skipLink}</a>
  <Header locale={locale} content={headerContent} wordmarkLabel={content.wordmarkLabel} activePageKey={pageKey} ctaHref={routeMap.contact[locale]} />
  <main id="main-content">
    <section class="legal-hero section-anchor" id="legal-top">
      <div class="container">
        <Breadcrumbs label={content.breadcrumbLabel} items={breadcrumbItems} />
        <div class="legal-hero__copy">
          <p class="eyebrow">{content.eyebrow}</p>
          <h1>{content.heading}</h1>
          <p class="legal-review-note">{content.reviewNote}</p>
        </div>
      </div>
    </section>

    <section class="legal-content section-anchor" id="legal-content">
      <div class="container legal-content__layout">
        <aside class="legal-toc" aria-label={content.contentsLabel}>
          <p class="eyebrow">{content.contentsLabel}</p>
          <ol>
            {content.sections.map((section) => <li><a href={`#${section.id}`}>{section.heading}</a></li>)}
            <li><a href="#contact-information">{content.contactHeading}</a></li>
          </ol>
        </aside>
        <article class="legal-article">
          {content.sections.map((section) => (
            <section id={section.id} class="legal-article__section section-anchor">
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </section>
          ))}
          <section id="contact-information" class="legal-article__section section-anchor">
            <h2>{content.contactHeading}</h2>
            <p>{content.contactBody}</p>
          </section>
          <p class="legal-home-link"><a class="text-link" href={homeHref}>{content.homeLabel} <span aria-hidden="true">→</span></a></p>
        </article>
      </div>
    </section>
  </main>
  <Footer locale={locale} content={shared.footer} navigation={navigation} services={services} wordmarkLabel={content.wordmarkLabel} />
  <LanguageSwitcher locale={locale} pageKey={pageKey} label={content.languageSwitcherLabel} />
</BaseLayout>
