---
import { getCollection } from 'astro:content';
import ResourceArticle from '../../../components/ResourceArticle.astro';

export async function getStaticPaths() {
  const entries = await getCollection('resources');
  return entries.filter((entry) => !entry.data.draft && entry.data.pubDate <= new Date()).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<ResourceArticle locale="es" entry={entry} />
